# Required: connection string for the throwaway Neon database
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Optional. Extra allowed frontend origins, comma-separated (localhost:5173 is always allowed)
# FRONTEND_ORIGINS=https://your-site.vercel.app
# Optional. If unset, a random secret is generated into backend/.jwt_secret (git-ignored)
# JWT_SECRET=
# Production only: set COOKIE_SECURE=1, and COOKIE_SAMESITE=none if frontend and API are on different sites
COOKIE_SECURE=0
COOKIE_SAMESITE=lax
